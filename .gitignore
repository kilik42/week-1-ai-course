# ==============================================================================
# Project Specific Ignores
# ==============================================================================
# Ignore the video folder to prevent massive uploads
video/

# (Optional) Block common video formats anywhere in the project just in case
*.mp4
*.mov
*.avi
*.mkv
*.wmv

# ==============================================================================
# Python / Jupyter Notebooks
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Data files (Don't accidental upload huge datasets)
*.csv
*.json
*.sqlite

# ==============================================================================
# Operating System Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk

# ==============================================================================
# IDEs and Text Editors
# ==============================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm / IntelliJ
.idea/